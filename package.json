{
  "name": "winston-logstash",
  "version": "2.1.1",
  "description": "A Logstash transport for winston",
  "main": "./lib/winston-logstash",
  "types": "./lib/index.d.ts",
  "homepage": "https://github.com/jaakkos/winston-logstash",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "watch": "babel src --out-dir lib --extensions '.ts' --watch",
    "build": "babel src --out-dir lib --extensions '.ts' && npm run build:types",
    "build:types": "node node_modules/typescript7/bin/tsc --project tsconfig.types.json && node scripts/build-index-dts.js",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "typecheck": "node node_modules/typescript7/bin/tsc --project tsconfig.json"
  },
  "files": [
    "lib/"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jaakkos/winston-logstash.git"
  },
  "peerDependencies": {
    "winston": "^0.7.3 || ^1.0.0 || ^2.0.0 || ^3.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "auto-changelog": "^2.5.0",
    "chai": "^6.2.2",
    "eslint": "^10.1.0",
    "eslint-config-google": "^0.14.0",
    "globals": "^17.1.0",
    "jest": "^30.2.0",
    "mocha": "^12.0.2",
    "timekeeper": "^2.3.1",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.53.1",
    "typescript7": "npm:typescript@^7.0.2",
    "winston": "^0.7.3 || ^1.0.0 || ^2.0.0 || ^3.0.0"
  },
  "keywords": [
    "logging",
    "sysadmin",
    "tools"
  ],
  "bugs": {
    "url": "https://github.com/jaakkos/winston-logstash/issues"
  },
  "author": "Jaakko Suutarla <jaakko@suutarla.com>",
  "license": "MIT",
  "contributors": [
    "Jaakko Suutarla <jaakko@suutarla.com>",
    "Chris Saylor <cjsaylor@gmail.com>",
    "djmax",
    "gwhitelaw",
    "Ivan Fraixedes",
    "kgoerlitz",
    "Akta3d",
    "KamalAman"
  ],
  "maintainers": [
    "Jaakko Suutarla <jaakko@suutarla.com>"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "dependencies": {
    "winston-transport": "^4.9.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
