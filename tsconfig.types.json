{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "target": "ES2022",
    "rootDir": "./src",
    "outDir": ".types-tmp",
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
