{
  "compilerOptions": {
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "strict": true,
    "target": "ES5",
    "module": "AMD",
    "baseUrl": ".",
    "outDir": "lib",
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": ["node", "jest"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
